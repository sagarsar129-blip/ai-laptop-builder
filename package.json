{
  "name": "ai-laptop-builder",
  "version": "1.0.0",
  "type": "module",
  "description": "Secure AI-powered app builder with real-time web dashboard",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --loader ts-node/esm backend/server.ts",
    "build": "tsc && cd web && npm run build",
    "start": "node dist/backend/server.js",
    "web:dev": "cd web && npm run dev",
    "web:build": "cd web && npm run build",
    "web:start": "cd web && npm run start",
    "engine:demo": "node --loader ts-node/esm src/index.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "test:integration": "jest backend/tests/integration.test.ts"
  },
  "keywords": [
    "ai",
    "builder",
    "sandbox",
    "security",
    "automation",
    "dashboard"
  ],
  "author": "AI Laptop Builder",
  "license": "MIT",
  "dependencies": {
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lucide-react": "^0.263.1",
    "zustand": "^4.4.1",
    "tailwindcss": "^3.3.6",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.2",
    "ts-node": "^10.9.1",
    "eslint": "^8.54.0",
    "eslint-config-next": "^14.0.0",
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1"
  }
}
