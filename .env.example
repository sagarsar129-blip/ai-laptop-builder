/**
 * Environment variables for AI Laptop Builder
 * Copy this to .env.local and fill in values
 */

# Backend server configuration
NODE_ENV=development
PORT=3000
HOSTNAME=localhost

# AIBuilder configuration
PROJECT_ROOT=./demo-project

# Backend API URL (for production)
BUILDER_API=http://localhost:3000

# Dashboard configuration
NEXT_PUBLIC_PROJECT_ROOT=./demo-project
NEXT_PUBLIC_BUILDER_API=http://localhost:3000

# Development: Use mock data instead of real backend
NEXT_PUBLIC_USE_MOCK_DATA=false
